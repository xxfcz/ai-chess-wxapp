/* ------------------------------------------------------------ 走子记录（样式见 move-list.wxss，已抽为 L1 共享组件） */

/* 运行日志 */
.log-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.log-actions .btn {
  margin: 0 12rpx 12rpx 0;
}

.log-box {
  /* 日志随页面一起滚动，内部不再套一层滚动条 */
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background-color: #12161f;
  border: 2rpx solid #232a3a;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  border-bottom: 2rpx solid #1b2130;
}

.log-row:last-child {
  border-bottom: none;
}

.log-time {
  width: 108rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6f778a;
  font-family: Menlo, Consolas, monospace;
}

.log-level {
  width: 76rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  font-family: Menlo, Consolas, monospace;
}

.level-info {
  color: #7fb0ff;
}

.level-log {
  color: #8d96ad;
}

.level-warn {
  color: #f0b232;
}

.level-error {
  color: #ff8b7a;
}

.log-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.5;
  color: #c8cfdd;
  word-break: break-all;
}


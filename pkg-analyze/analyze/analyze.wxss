.page {
  height: 100vh;
  padding: 20rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/*
  可滚动区：状态 + 控制按钮 + Tab 内容整体滚动。
  棋盘是它上面唯一固定的元素，所以划动时棋盘始终留在上半屏。
*/
.body {
  flex: 1;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
  /* 兜底：远端预览若未渲染原生 scroll-view 的滚动，靠这条保证可上下划动 */
  overflow-y: auto;
  /* 纵向拖拽归为滚动，不再被「选词」吃掉 */
  touch-action: pan-y;
  overscroll-behavior: contain;
}

/* 可点击元素的指针光标，提示可交互 */
.tab {
  cursor: pointer;
}

/* 滚回顶部用的锚点（切换 Tab 时改变 id 即可重新触发滚动） */
.anchor {
  height: 0;
}

/* Tab 栏：钉在底部，不参与滚动 */
.tabs {
  flex-shrink: 0;
  display: flex;
  margin: 14rpx 0 22rpx;
  background-color: #141922;
  border: 2rpx solid #2d3548;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 6rpx;
  font-size: 23rpx;
  color: #8d96ad;
  border-right: 2rpx solid #2d3548;
}

.tab:last-child {
  border-right: none;
}

.tab-active {
  background-color: #f0b232;
  color: #241c07;
  font-weight: 600;
}

.tab-label {
  line-height: 1.2;
  text-align: center;
}

/* Tab 内容与状态、控制按钮同属一个滚动区，这里不再单独滚动 */

/* ------------------------------------------------------------ FEN 卡片 */

.fen-row {
  align-items: stretch;
}

.fen-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  margin-right: 16rpx;
  background-color: #12161f;
  border: 2rpx solid #2d3548;
  border-radius: 14rpx;
  color: #e9ecf5;
  font-size: 24rpx;
  font-family: Menlo, Consolas, monospace;
  /* 输入框必须可编辑/可定位光标，恢复选择与文本光标 */
  -webkit-user-select: text;
  user-select: text;
  cursor: text;
}

.fen-placeholder {
  color: #5c6577;
  font-size: 22rpx;
}

.fen-actions {
  margin-top: 16rpx;
  align-items: center;
}

/* ------------------------------------------------------------ 分析面板 */

/* 滚动区内的卡片：上下留白由卡片自身给，整体跟着划动（.card 的 padding/bg/border 见全局 app.wxss） */
.card {
  margin: 24rpx 0 0;
}

/* 引擎来源徽标：云端可用为绿，已降级到本地为琥珀（.chip-ok/.chip-warn 见全局 app.wxss） */


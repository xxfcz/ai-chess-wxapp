page {
  --bg: #0f1118;
  --panel: #1a1f2b;
  --panel-2: #222839;
  --border: #2d3548;
  --text: #e9ecf5;
  --muted: #8d96ad;
  --accent: #f0b232;
  --good: #35c26b;
  --bad: #e8664f;

  background-color: #0f1118;
  color: #e9ecf5;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
scroll-view,
button {
  box-sizing: border-box;
  /* 预览面板把 WXML 渲染成网页 DOM，文字默认可选中（I 型光标 + 拖拽=选中文本），
     会抢走纵向滑动手势。关闭选择并还原默认箭头光标，滑动就顺了。 */
  -webkit-user-select: none;
  user-select: none;
  -webkit-tap-highlight-color: transparent;
  cursor: default;
}

.card {
  background-color: #1a1f2b;
  border: 2rpx solid #2d3548;
  border-radius: 20rpx;
  padding: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.gap {
  flex: 1;
}

.muted {
  color: #8d96ad;
}

.section-title {
  font-size: 26rpx;
  color: #8d96ad;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background-color: #222839;
  border: 2rpx solid #2d3548;
  color: #e9ecf5;
  font-size: 26rpx;
  line-height: 1;
}

.btn.primary {
  background-color: #f0b232;
  border-color: #f0b232;
  color: #241c07;
  font-weight: 600;
}

.btn.ghost {
  background-color: transparent;
}

.btn[disabled],
.btn.disabled {
  opacity: 0.4;
}

/* ------------------------------------------------------------
   以下为「平台级共享原子类」，被所有 L1 共享 UI 组件复用（app.wxss 全局生效）。
   从 analyze.wxss 迁出，确保 BoardView / SessionBar / EnginePanel / CommentCard /
   MoveList 等组件不依赖某个具体页面的样式（平台化重构 · L1）。
*/

.btn.small {
  height: 58rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

/* 可点击元素的指针光标，提示可交互 */
.btn,
.chip {
  cursor: pointer;
}

.tiny {
  font-size: 22rpx;
}

/* 卡片小标题行：标题 + 右侧操作/徽标 */
.head {
  align-items: center;
  margin-bottom: 12rpx;
}

.head .section-title {
  margin-bottom: 0;
}

.head picker {
  margin-right: 14rpx;
}

.head .btn.small {
  margin-left: 14rpx;
}

/* 引擎来源徽标：云端可用为绿，已降级到本地为琥珀 */
.chip-ok {
  color: #35c26b;
  border-color: #2f6b45;
}

.chip-warn {
  color: #e8a34f;
  border-color: #6b542f;
}

/* 失败原因的排查线索：小字、等宽、不抢眼 */
.error {
  display: block;
  margin-top: 12rpx;
  color: #e8664f;
  font-size: 24rpx;
}

.tech-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: #5c6577;
  font-family: Menlo, Consolas, monospace;
  word-break: break-all;
}

/* 分数 / 状态配色：白方视角为正（被状态条与引擎面板共用） */
.tone-white {
  color: #35c26b;
}

.tone-black {
  color: #e8664f;
}

.tone-even {
  color: #c3cadb;
}

.tone-mate {
  color: #f0b232;
}

.tone-check {
  color: #e8664f;
}

.tone-over {
  color: #f0b232;
}

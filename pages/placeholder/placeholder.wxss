.page {
  min-height: 100vh;
  padding: 40rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ph-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx 36rpx;
}

.ph-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #e9ecf5;
  margin-bottom: 16rpx;
}

.ph-desc {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

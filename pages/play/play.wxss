.page {
  height: 100vh;
  padding: 20rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.body {
  flex: 1;
  min-height: 0;
  -webkit-overflow-scrolling: touch;
  overflow-y: auto;
  touch-action: pan-y;
  overscroll-behavior: contain;
}

.tab {
  cursor: pointer;
}

.anchor {
  height: 0;
}

.tabs {
  flex-shrink: 0;
  display: flex;
  margin: 14rpx 0 22rpx;
  background-color: #141922;
  border: 2rpx solid #2d3548;
  border-radius: 16rpx;
  overflow: hidden;
}

.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 6rpx;
  font-size: 23rpx;
  color: #8d96ad;
  border-right: 2rpx solid #2d3548;
}

.tab:last-child {
  border-right: none;
}

.tab-active {
  background-color: #f0b232;
  color: #241c07;
  font-weight: 600;
}

.tab-label {
  line-height: 1.2;
  text-align: center;
}

/* ------------------------------------------------------- 对弈控制条 */

.play-bar {
  margin: 16rpx 0 0;
}

.play-row {
  align-items: center;
  margin-bottom: 14rpx;
}

.play-row:last-child {
  margin-bottom: 0;
}

.seg {
  display: flex;
  flex: 1;
  margin-left: 16rpx;
  background-color: #12161f;
  border: 2rpx solid #2d3548;
  border-radius: 12rpx;
  overflow: hidden;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #8d96ad;
  border-right: 2rpx solid #2d3548;
}

.seg-item:last-child {
  border-right: none;
}

.seg-active {
  background-color: #f0b232;
  color: #241c07;
  font-weight: 600;
}

.play-status {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #7fb0ff;
}

.play-status.thinking {
  color: #f0b232;
}

/* ------------------------------------------------------------ 卡片/日志 */

.fen-row {
  align-items: stretch;
}

.fen-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  margin-right: 16rpx;
  background-color: #12161f;
  border: 2rpx solid #2d3548;
  border-radius: 14rpx;
  color: #e9ecf5;
  font-size: 24rpx;
  font-family: Menlo, Consolas, monospace;
  -webkit-user-select: text;
  user-select: text;
  cursor: text;
}

.fen-placeholder {
  color: #5c6577;
  font-size: 22rpx;
}

.fen-actions {
  margin-top: 16rpx;
  align-items: center;
}

.log-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.log-actions .btn {
  margin: 0 12rpx 12rpx 0;
}

.log-box {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background-color: #12161f;
  border: 2rpx solid #232a3a;
}

.log-row {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
  border-bottom: 2rpx solid #1b2130;
}

.log-row:last-child {
  border-bottom: none;
}

.log-time {
  width: 108rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6f778a;
  font-family: Menlo, Consolas, monospace;
}

.log-level {
  width: 76rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  font-family: Menlo, Consolas, monospace;
}

.level-info { color: #7fb0ff; }
.level-log { color: #8d96ad; }
.level-warn { color: #f0b232; }
.level-error { color: #ff8b7a; }

.log-text {
  flex: 1;
  font-size: 21rpx;
  line-height: 1.5;
  color: #c8cfdd;
  word-break: break-all;
}
